extends SceneTree

# Offline correctness and copy timing in a tools/performance/prepare.ps1
# project. The source world is never stepped or given a command. Save admission,
# SQLite, canonical encoding, commit validation and loading use their owners.
const COPY_SAMPLES: int = 20
const INT64_FLOAT_LIMIT: float = 9223372036854775808.0

var _output: String = ""
var _guard: RefCounted
var _store: HospitalSnapshots
var _simulation: HospitalSimulation
var _report: Dictionary = {"schema_version":1,"ok":false,"scope":"paused full-facts persistence roundtrip and isolated freeze copies; not formal Release performance acceptance","stage":"arguments","timings_us":{}}

func _initialize() -> void:
	call_deferred("_run")

func _run() -> void:
	var input: String = ""
	for argument: String in OS.get_cmdline_user_args():
		if argument.begins_with("--input="): input = argument.trim_prefix("--input=")
		elif argument.begins_with("--output="): _output = argument.trim_prefix("--output=")
		else:
			_finish("Unknown argument: "+argument)
			return
	if not input.is_absolute_path() or not _output.is_absolute_path() or not FileAccess.file_exists(input) or FileAccess.file_exists(_output):
		_finish("Provide an existing absolute --input=<Fixture bin> and a new absolute --output=<JSON>.")
		return
	_report.input_path = input
	_report.output_path = _output
	_report.engine = Engine.get_version_info()
	_report.executable = OS.get_executable_path()
	_report.features = {"template":OS.has_feature("template"),"release":OS.has_feature("release"),"debug":OS.has_feature("debug")}
	_report.started_utc = Time.get_datetime_string_from_system(true)
	_report.stage = "isolated_preparation_profile"
	var identity_path: String = ProjectSettings.globalize_path("res://source-identity.json")
	var identity: Variant = JSON.parse_string(FileAccess.get_file_as_string(identity_path)) if FileAccess.file_exists(identity_path) else null
	var profile: String = str(ProjectSettings.get_setting("application/config/custom_user_dir_name",""))
	var project: String = ProjectSettings.globalize_path("res://")
	if not identity is Dictionary or not profile.begins_with("OddlyGoodHospital Performance ") or str(identity.get("profile",""))!=profile or _path_key(str(identity.get("project","")))!=_path_key(project) or not bool(ProjectSettings.get_setting("application/config/use_custom_user_dir",false)):
		_finish("Run only in an isolated project generated by tools/performance/prepare.ps1; the player profile is forbidden.")
		return
	_report.preparation = {"project":project,"profile":profile,"user_data_dir":OS.get_user_data_dir(),"identity_path":identity_path,"identity_sha256":FileAccess.get_sha256(identity_path),"head":identity.get("head","")}
	if not ClassDB.class_exists("PlatformSessionGuard"):
		_finish("Original PlatformSessionGuard is unavailable.")
		return
	_guard = ClassDB.instantiate("PlatformSessionGuard") as RefCounted
	var acquired: Dictionary = _guard.call("acquire")
	_report.guard_acquire = acquired
	if not bool(acquired.get("ok",false)) or not bool(_guard.call("is_held")):
		_finish("Cannot acquire the isolated preparation profile.")
		return
	_report.stage = "input_read_and_validation"
	var started: int = Time.get_ticks_usec()
	_report.input_sha256 = FileAccess.get_sha256(input)
	_report.timings_us.input_sha256 = Time.get_ticks_usec()-started
	if not HospitalSnapshots._valid_sha(str(_report.input_sha256)):
		_finish("Cannot hash the original input.")
		return
	var file: FileAccess = FileAccess.open(input,FileAccess.READ)
	if file==null:
		_finish("Cannot open original input.")
		return
	_report.input_bytes = file.get_length()
	started = Time.get_ticks_usec()
	var raw: Variant = file.get_var(false)
	_report.timings_us.input_decode = Time.get_ticks_usec()-started
	var read_error: Error = file.get_error()
	var consumed: int = file.get_position()
	file.close()
	if read_error!=OK or consumed!=int(_report.input_bytes) or not raw is Dictionary or not raw.get("facts") is Dictionary:
		_finish("Input is not one complete Fixture envelope with full world facts.")
		return
	var content: HospitalContent = HospitalContent.new()
	if not content.error.is_empty() or str(raw.get("content_fingerprint",""))!=content.content_fingerprint:
		_finish("Input content identity differs from the current registry: "+content.error)
		return
	_report.content_fingerprint = content.content_fingerprint
	var world: WorldState = WorldState.new(raw.facts)
	started = Time.get_ticks_usec()
	var validation: String = world.validate(content)
	_report.timings_us.input_validate = Time.get_ticks_usec()-started
	_report.input_validation = validation
	_report.hospital_id = world.facts.get("hospital_id","")
	_report.tick = world.facts.get("sim_tick",-1)
	_report.revision = world.facts.get("world_revision",-1)
	if not validation.is_empty():
		_finish("Input world validation failed: "+validation)
		return
	if DirAccess.dir_exists_absolute(HospitalSnapshots.ROOT.path_join(world.hospital_id)):
		_finish("This hospital UUID already exists in the isolated profile; use a fresh prepared project.")
		return
	_report.stage = "independent_freeze_copies"
	var before: Dictionary = {}
	var samples: Array[Dictionary] = []
	var all_times: Array[int] = []
	var warm_times: Array[int] = []
	for index: int in COPY_SAMPLES:
		started = Time.get_ticks_usec()
		var copied: Dictionary = world.freeze()
		var elapsed: int = Time.get_ticks_usec()-started
		var comparison_started: int = Time.get_ticks_usec()
		var independent: bool = not is_same(copied,world.facts) and (index==0 or not is_same(copied,before))
		var equal: bool = _same(copied,world.facts)
		samples.append({"index":index,"cohort":"first_process_freeze" if index==0 else "subsequent_independent_freeze","copy_main_wall_us":elapsed,"comparison_main_wall_us":Time.get_ticks_usec()-comparison_started,"independent_root":independent,"complete_facts_equal":equal})
		all_times.append(elapsed)
		if index==0: before = copied
		else: warm_times.append(elapsed)
		# Retain the first baseline plus only the current copy, never 20 large
		# live worlds. Allocation, complete comparison and release are separate.
		copied = {}
		if not independent or not equal:
			_report.copy_samples = samples
			_finish("An original freeze did not produce an independent complete copy.")
			return
	_report.copy_samples = samples
	_report.copy_summary_us = {"count":COPY_SAMPLES,"first_process_freeze":all_times[0],"all_p95_nearest_rank":_p95(all_times),"subsequent_count":warm_times.size(),"subsequent_p95_nearest_rank":_p95(warm_times),"cold_scope":"first freeze invocation in this process; no OS cache eviction; first sample also reported separately","excluded_from_copy_timer":"full comparison and reference release"}
	_report.stage = "simulation_construction"
	started = Time.get_ticks_usec()
	_simulation = HospitalSimulation.new(world,content)
	_report.timings_us.simulation_construct = Time.get_ticks_usec()-started
	started = Time.get_ticks_usec()
	_report.simulation_construction_preserved_full_facts = _same(before,world.facts)
	_report.timings_us.simulation_facts_comparison = Time.get_ticks_usec()-started
	if not _report.simulation_construction_preserved_full_facts or _simulation.pending() or not _simulation.save_boundary_ready():
		_finish("Original Simulation construction changed input facts or did not provide an idle complete boundary.")
		return
	_report.stage = "canonical_before"
	started = Time.get_ticks_usec()
	var before_hash: Dictionary = _canonical(before)
	_report.timings_us.canonical_before = Time.get_ticks_usec()-started
	_report.before_canonical = before_hash
	if not before_hash.ok:
		_finish("Cannot canonically encode the complete source facts: "+str(before_hash.error))
		return
	_store = HospitalSnapshots.new(content,_guard)
	_report.stage = "original_snapshot_save"
	var save_started: int = Time.get_ticks_usec()
	var begin: Dictionary = _store.begin(_simulation,"paused-roundtrip-diagnostic","manual","roundtrip")
	_report.timings_us.save_begin_main_inclusive = Time.get_ticks_usec()-save_started
	_report.save_begin = begin
	if not bool(begin.get("ok",false)):
		_finish("Original save admission failed: "+str(begin.get("error","")))
		return
	# A fresh Simulation has no queued commands or partial step. Refuse a
	# deferred source rather than letting wait_for_idle advance a partial step.
	if bool(begin.get("request",{}).get("pending",false)) or _simulation.pending():
		_finish("Unexpected deferred save; no simulation step is permitted.")
		return
	started = Time.get_ticks_usec()
	var receipt: Dictionary = _store.wait_for_idle()
	_report.timings_us.save_wait_main_blocking_wall = Time.get_ticks_usec()-started
	_report.timings_us.save_total_wall = Time.get_ticks_usec()-save_started
	_report.save_receipt = receipt
	if not bool(receipt.get("ok",false)):
		_finish("Original SQLite save did not complete: "+str(receipt.get("error","")))
		return
	var snapshot_id: String = str(receipt.get("snapshot_id",""))
	_report.snapshot_id = snapshot_id
	if not HospitalSnapshots.valid_uuid(snapshot_id) or str(receipt.get("hospital_id",""))!=world.hospital_id or int(receipt.get("sim_tick",-1))!=int(before.sim_tick) or int(receipt.get("world_revision",-1))!=int(before.world_revision):
		_finish("Save receipt does not identify the original frozen boundary.")
		return
	_report.stage = "original_library_load_exact_snapshot"
	var library: HospitalLibrary = HospitalLibrary.new(content,_store)
	started = Time.get_ticks_usec()
	var loaded: Dictionary = library.continue_hospital(world.hospital_id,snapshot_id)
	_report.timings_us.load_main_inclusive_wall = Time.get_ticks_usec()-started
	_report.load_scope = "first explicit Library.continue_hospital of the receipt snapshot; original save worker already validates its commit"
	if not bool(loaded.get("ok",false)):
		_finish("Original Library load failed: "+str(loaded.get("error","")))
		return
	var restored: WorldState = loaded.world
	_report.manifest = loaded.manifest
	started = Time.get_ticks_usec()
	var restored_validation: String = restored.validate(content)
	_report.timings_us.loaded_validate = Time.get_ticks_usec()-started
	_report.loaded_validation = restored_validation
	started = Time.get_ticks_usec()
	var after: Dictionary = restored.freeze()
	_report.timings_us.loaded_freeze_main_wall = Time.get_ticks_usec()-started
	_report.stage = "complete_facts_comparison"
	started = Time.get_ticks_usec()
	_report.full_facts_equal = _same(before,after)
	_report.original_world_unchanged = _same(before,world.facts)
	_report.rng_equal = _same(before.rng,after.rng)
	_report.timings_us.full_facts_comparison = Time.get_ticks_usec()-started
	started = Time.get_ticks_usec()
	var after_hash: Dictionary = _canonical(after)
	_report.timings_us.canonical_after = Time.get_ticks_usec()-started
	_report.after_canonical = after_hash
	started = Time.get_ticks_usec()
	_report.input_sha256_after = FileAccess.get_sha256(input)
	_report.timings_us.input_sha256_after = Time.get_ticks_usec()-started
	_report.source_bin_unchanged = _report.input_sha256_after==_report.input_sha256
	_report.exact_snapshot_loaded = str(loaded.manifest.get("hospital_id",""))==world.hospital_id and str(loaded.manifest.get("snapshot_id",""))==snapshot_id
	_report.manifest_matches_source_canonical = int(loaded.manifest.get("world_bytes",-1))==int(before_hash.bytes) and str(loaded.manifest.get("world_sha256",""))==str(before_hash.sha256)
	_report.canonical_hashes_equal = after_hash.ok and before_hash.sha256==after_hash.sha256 and before_hash.bytes==after_hash.bytes
	_report.comparison_contract = "Full recursive Dictionary/Array/scalar comparison, with lossless integral int/float JSON equivalence; hashes are additional identities and never replace complete field comparison. RNG decimal strings remain exact."
	_report.timing_contract = "Monotonic main-thread wall time in microseconds. Save begin includes original validation/estimate/freeze/thread launch; save total/wait include worker and IO wall time, not worker CPU. Canonical diagnostics and correctness comparisons are timed separately. No performance threshold or Release pass is inferred."
	if not restored_validation.is_empty() or not _report.full_facts_equal or not _report.original_world_unchanged or not _report.rng_equal or not _report.source_bin_unchanged or not _report.exact_snapshot_loaded or not _report.manifest_matches_source_canonical or not _report.canonical_hashes_equal:
		_finish("Complete paused persistence roundtrip did not preserve every required fact or identity.")
		return
	_report.stage = "complete"
	_finish("")

func _canonical(facts: Dictionary) -> Dictionary:
	var encoder: HospitalJsonStream = HospitalJsonStream.new()
	# Read-only hash observation has no persistence admission decision. Actual
	# save/load retain HospitalSnapshots._budget and the acquired native guard.
	var observation_budget: Callable = func(_bytes: int) -> bool: return true
	var discard_sink: Callable = func(_chunk: PackedByteArray) -> Dictionary: return {"ok":true}
	var encoded: bool = encoder.encode_to(facts,observation_budget,discard_sink)
	return {"ok":encoded,"bytes":encoder.bytes,"sha256":encoder.digest,"error":encoder.error,"encoder":"original HospitalJsonStream, complete canonical content, discard sink"}

func _same(first: Variant, second: Variant) -> bool:
	# Identical typed containers compare all fields in the engine. In contrast,
	# stringify/parse of the complete world would round large int64 values.
	if typeof(first)==typeof(second) and first==second: return true
	if first is Dictionary and second is Dictionary:
		if first.size()!=second.size(): return false
		for key: Variant in first:
			if not second.has(key) or not _same(first[key],second[key]): return false
		return true
	if first is Array and second is Array:
		if first.size()!=second.size(): return false
		for index: int in first.size():
			if not _same(first[index],second[index]): return false
		return true
	if (first is int and second is float) or (first is float and second is int):
		var decimal: float = second if second is float else first
		var integer: int = first if first is int else second
		return is_finite(decimal) and decimal>=-INT64_FLOAT_LIMIT and decimal<INT64_FLOAT_LIMIT and floor(decimal)==decimal and int(decimal)==integer
	if (first is String and second is StringName) or (first is StringName and second is String): return str(first)==str(second)
	return false

func _p95(values: Array[int]) -> int:
	var ordered: Array[int] = values.duplicate()
	ordered.sort()
	return ordered[ceili(ordered.size()*0.95)-1]

func _path_key(path: String) -> String:
	return path.replace("\\","/").trim_suffix("/").to_lower()

func _finish(error: String) -> void:
	_report.ok = error.is_empty()
	_report.error = error
	_report.finished_utc = Time.get_datetime_string_from_system(true)
	if _store!=null and _store.busy():
		# An unexpected deferred save is deliberately not advanced on failure.
		# Normal worker completion can always be joined before releasing owner.
		if _store._deferred_source==null: _store.wait_for_idle()
	if _simulation!=null: _simulation.dispose()
	if _guard!=null and bool(_guard.call("is_held")): _guard.call("release")
	var written: bool = false
	if _output.is_absolute_path() and not FileAccess.file_exists(_output):
		var parent: String = _output.get_base_dir()
		if DirAccess.make_dir_recursive_absolute(parent)==OK:
			var report_file: FileAccess = FileAccess.open(_output,FileAccess.WRITE)
			if report_file!=null:
				report_file.store_string(JSON.stringify(_report,"\t",true,true))
				report_file.flush()
				written = report_file.get_error()==OK
				report_file.close()
	print("PAUSED_ROUNDTRIP="+JSON.stringify({"ok":_report.ok and written,"report_written":written,"output":_output,"stage":_report.stage,"error":error,"scope":_report.scope}))
	if not error.is_empty(): push_error(error)
	if not written: push_error("Roundtrip report was not written; existing output is never overwritten.")
	quit(0 if _report.ok and written else 1)
