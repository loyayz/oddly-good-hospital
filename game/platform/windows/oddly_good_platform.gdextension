[configuration]
entry_symbol = "oddly_good_platform_init"
compatibility_minimum = "4.7.2"
reloadable = false

[libraries]
windows.debug.x86_64 = "res://game/platform/windows/bin/oddly_good_platform.windows.x86_64.dll"
windows.release.x86_64 = "res://game/platform/windows/bin/oddly_good_platform.windows.x86_64.dll"

[dependencies]
windows.x86_64 = { "res://game/platform/windows/bin/libgmp-10.dll": "", "res://game/platform/windows/bin/libmpfr-6.dll": "", "res://game/platform/windows/bin/libgcc_s_seh-1.dll": "", "res://game/platform/windows/bin/libwinpthread-1.dll": "" }
